From 11c3df39959ad6b9fbc3120976c499837553db9c Mon Sep 17 00:00:00 2001
From: Memberoffoxhound <Memberoffoxhound@users.noreply.github.com>
Date: Wed, 18 Nov 2026 01:38:58 -0600
Subject: [PATCH 4/6] Bluetooth: btqca: add WCN3990 firmware download

---
 drivers/bluetooth/btqca.c | 124 +++++++++++++++++++++++++++++---------
 drivers/bluetooth/btqca.h |  22 ++++++-
 2 files changed, 115 insertions(+), 31 deletions(-)

diff --git a/drivers/bluetooth/btqca.c b/drivers/bluetooth/btqca.c
index f64e86f4..3b252a6a 100644
--- a/drivers/bluetooth/btqca.c
+++ b/drivers/bluetooth/btqca.c
@@ -18,6 +18,7 @@
  *
  */
 #include <linux/module.h>
+#include <linux/delay.h>
 #include <linux/firmware.h>
 
 #include <net/bluetooth/bluetooth.h>
@@ -27,7 +28,7 @@
 
 #define VERSION "0.1"
 
-#define MAX_PATCH_FILE_SIZE (100*1024)
+#define MAX_PATCH_FILE_SIZE (200*1024)
 #define MAX_NVM_FILE_SIZE   (10*1024)
 
 static int rome_patch_ver_req(struct hci_dev *hdev, u32 *rome_version)
@@ -130,6 +131,9 @@ static void rome_tlv_check_data(struct rome_config *config,
 	BT_DBG("TLV Type\t\t : 0x%x", type_len & 0x000000ff);
 	BT_DBG("Length\t\t : %d bytes", length);
 
+	config->dnld_mode = ROME_SKIP_EVT_NONE;
+	config->dnld_type = ROME_SKIP_EVT_NONE;
+
 	switch (config->type) {
 	case TLV_TYPE_PATCH:
 		tlv_patch = (struct tlv_type_patch *)tlv->data;
@@ -141,8 +145,9 @@ static void rome_tlv_check_data(struct rome_config *config,
 		       tlv_patch->format_version);
 		BT_DBG("Signature Algorithm\t : 0x%x",
 		       tlv_patch->signature);
-		BT_DBG("Reserved\t\t : 0x%x",
-		       le16_to_cpu(tlv_patch->reserved1));
+		BT_DBG("Download mode\t\t : 0x%x", tlv_patch->download_mode);
+		config->dnld_mode = tlv_patch->download_mode;
+		config->dnld_type = config->dnld_mode;
 		BT_DBG("Product ID\t\t : 0x%04x",
 		       le16_to_cpu(tlv_patch->product_id));
 		BT_DBG("Rom Build Version\t : 0x%04x",
@@ -198,7 +203,7 @@ static void rome_tlv_check_data(struct rome_config *config,
 }
 
 static int rome_tlv_send_segment(struct hci_dev *hdev, int idx, int seg_size,
-				 const u8 *data)
+				 const u8 *data, u8 mode)
 {
 	struct sk_buff *skb;
 	struct edl_event_hdr *edl;
@@ -212,6 +217,10 @@ static int rome_tlv_send_segment(struct hci_dev *hdev, int idx, int seg_size,
 	cmd[1] = seg_size;
 	memcpy(cmd + 2, data, seg_size);
 
+	if (mode == ROME_SKIP_EVT_VSE_CC || mode == ROME_SKIP_EVT_VSE)
+		return __hci_cmd_send(hdev, EDL_PATCH_CMD_OPCODE, seg_size + 2,
+				      cmd);
+
 	skb = __hci_cmd_sync_ev(hdev, EDL_PATCH_CMD_OPCODE, seg_size + 2, cmd,
 				HCI_VENDOR_PKT, HCI_INIT_TIMEOUT);
 	if (IS_ERR(skb)) {
@@ -248,39 +257,66 @@ static int rome_tlv_send_segment(struct hci_dev *hdev, int idx, int seg_size,
 	return err;
 }
 
+/* The chip skipped the command complete for the download, fake one so the
+ * HCI command credit comes back
+ */
+static int qca_inject_cmd_complete_event(struct hci_dev *hdev)
+{
+	struct hci_event_hdr *hdr;
+	struct hci_ev_cmd_complete *evt;
+	struct sk_buff *skb;
+
+	skb = bt_skb_alloc(sizeof(*hdr) + sizeof(*evt) + 1, GFP_KERNEL);
+	if (!skb)
+		return -ENOMEM;
+
+	hdr = (struct hci_event_hdr *)skb_put(skb, sizeof(*hdr));
+	hdr->evt = HCI_EV_CMD_COMPLETE;
+	hdr->plen = sizeof(*evt) + 1;
+
+	evt = (struct hci_ev_cmd_complete *)skb_put(skb, sizeof(*evt));
+	evt->ncmd = 1;
+	evt->opcode = cpu_to_le16(QCA_HCI_CC_OPCODE);
+
+	*(u8 *)skb_put(skb, 1) = QCA_HCI_CC_SUCCESS;
+
+	hci_skb_pkt_type(skb) = HCI_EVENT_PKT;
+
+	return hci_recv_frame(hdev, skb);
+}
+
 static int rome_tlv_download_request(struct hci_dev *hdev,
-				     const struct firmware *fw)
+				     const struct firmware *fw,
+				     struct rome_config *config)
 {
-	const u8 *buffer, *data;
-	int total_segment, remain_size;
-	int ret, i;
+	const u8 *segment;
+	int ret, remain, i = 0;
 
 	if (!fw || !fw->data)
 		return -EINVAL;
 
-	total_segment = fw->size / MAX_SIZE_PER_TLV_SEGMENT;
-	remain_size = fw->size % MAX_SIZE_PER_TLV_SEGMENT;
+	segment = fw->data;
+	remain = fw->size;
+	while (remain > 0) {
+		int segsize = min(MAX_SIZE_PER_TLV_SEGMENT, remain);
 
-	BT_DBG("%s: Total segment num %d remain size %d total size %zu",
-	       hdev->name, total_segment, remain_size, fw->size);
+		remain -= segsize;
+		/* The last segment is always acked */
+		if (!remain || segsize < MAX_SIZE_PER_TLV_SEGMENT)
+			config->dnld_mode = ROME_SKIP_EVT_NONE;
 
-	data = fw->data;
-	for (i = 0; i < total_segment; i++) {
-		buffer = data + i * MAX_SIZE_PER_TLV_SEGMENT;
-		ret = rome_tlv_send_segment(hdev, i, MAX_SIZE_PER_TLV_SEGMENT,
-					    buffer);
+		ret = rome_tlv_send_segment(hdev, i++, segsize, segment,
+					    config->dnld_mode);
 		if (ret < 0)
 			return -EIO;
-	}
 
-	if (remain_size) {
-		buffer = data + total_segment * MAX_SIZE_PER_TLV_SEGMENT;
-		ret = rome_tlv_send_segment(hdev, total_segment, remain_size,
-					    buffer);
-		if (ret < 0)
-			return -EIO;
+		segment += segsize;
 	}
 
+	if (config->dnld_type == ROME_SKIP_EVT_VSE_CC ||
+	    config->dnld_type == ROME_SKIP_EVT_VSE)
+		return qca_inject_cmd_complete_event(hdev);
+
 	return 0;
 }
 
@@ -337,7 +373,7 @@ static int rome_download_firmware(struct hci_dev *hdev,
 	}
 
 	rome_tlv_check_data(config, fw);
-	ret = rome_tlv_download_request(hdev, fw);
+	ret = rome_tlv_download_request(hdev, fw, config);
 
 	if (ret) {
 		BT_ERR("Failed to download FW: error = (%d)", ret);
@@ -374,9 +410,11 @@ int qca_set_bdaddr_rome(struct hci_dev *hdev, const bdaddr_t *bdaddr)
 }
 EXPORT_SYMBOL_GPL(qca_set_bdaddr_rome);
 
-int qca_uart_setup_rome(struct hci_dev *hdev, uint8_t baudrate)
+static int qca_uart_setup(struct hci_dev *hdev, uint8_t baudrate,
+			  bool wcn3990)
 {
 	u32 rome_ver = 0;
+	u8 rom;
 	struct rome_config config;
 	int err;
 
@@ -393,20 +431,35 @@ int qca_uart_setup_rome(struct hci_dev *hdev, uint8_t baudrate)
 
 	BT_INFO("%s: ROME controller version 0x%08x", hdev->name, rome_ver);
 
+	/* WCN3990 files are named after the ROM version, 0x0201 -> 21 */
+	rom = ((rome_ver & 0x00000f00) >> 4) | (rome_ver & 0x0000000f);
+
 	/* Download rampatch file */
 	config.type = TLV_TYPE_PATCH;
-	snprintf(config.fwname, sizeof(config.fwname), "qca/rampatch_%08x.bin",
-		 rome_ver);
+	if (wcn3990)
+		snprintf(config.fwname, sizeof(config.fwname),
+			 "qca/crbtfw%02x.tlv", rom);
+	else
+		snprintf(config.fwname, sizeof(config.fwname),
+			 "qca/rampatch_%08x.bin", rome_ver);
 	err = rome_download_firmware(hdev, &config);
 	if (err < 0) {
 		BT_ERR("%s: Failed to download patch (%d)", hdev->name, err);
 		return err;
 	}
 
+	/* Give the controller time to get ready for the NVM */
+	if (wcn3990)
+		msleep(10);
+
 	/* Download NVM configuration */
 	config.type = TLV_TYPE_NVM;
-	snprintf(config.fwname, sizeof(config.fwname), "qca/nvm_%08x.bin",
-		 rome_ver);
+	if (wcn3990)
+		snprintf(config.fwname, sizeof(config.fwname),
+			 "qca/crnv%02x.bin", rom);
+	else
+		snprintf(config.fwname, sizeof(config.fwname),
+			 "qca/nvm_%08x.bin", rome_ver);
 	err = rome_download_firmware(hdev, &config);
 	if (err < 0) {
 		BT_ERR("%s: Failed to download NVM (%d)", hdev->name, err);
@@ -424,8 +477,19 @@ int qca_uart_setup_rome(struct hci_dev *hdev, uint8_t baudrate)
 
 	return 0;
 }
+
+int qca_uart_setup_rome(struct hci_dev *hdev, uint8_t baudrate)
+{
+	return qca_uart_setup(hdev, baudrate, false);
+}
 EXPORT_SYMBOL_GPL(qca_uart_setup_rome);
 
+int qca_uart_setup_wcn3990(struct hci_dev *hdev, uint8_t baudrate)
+{
+	return qca_uart_setup(hdev, baudrate, true);
+}
+EXPORT_SYMBOL_GPL(qca_uart_setup_wcn3990);
+
 MODULE_AUTHOR("Ben Young Tae Kim <ytkim@qca.qualcomm.com>");
 MODULE_DESCRIPTION("Bluetooth support for Qualcomm Atheros family ver " VERSION);
 MODULE_VERSION(VERSION);
diff --git a/drivers/bluetooth/btqca.h b/drivers/bluetooth/btqca.h
index 65e994b9..2112c2d6 100644
--- a/drivers/bluetooth/btqca.h
+++ b/drivers/bluetooth/btqca.h
@@ -37,6 +37,9 @@
 #define EDL_TAG_ID_HCI			(17)
 #define EDL_TAG_ID_DEEP_SLEEP		(27)
 
+#define QCA_HCI_CC_OPCODE		(0xFC00)
+#define QCA_HCI_CC_SUCCESS		(0x00)
+
 enum qca_bardrate {
 	QCA_BAUDRATE_115200 	= 0,
 	QCA_BAUDRATE_57600,
@@ -61,6 +64,14 @@ enum qca_bardrate {
 	QCA_BAUDRATE_RESERVED
 };
 
+/* Newer chips skip some download acks, from the patch TLV header */
+enum rome_tlv_dnld_mode {
+	ROME_SKIP_EVT_NONE,
+	ROME_SKIP_EVT_VSE,
+	ROME_SKIP_EVT_CC,
+	ROME_SKIP_EVT_VSE_CC
+};
+
 enum rome_tlv_type {
 	TLV_TYPE_PATCH = 1,
 	TLV_TYPE_NVM
@@ -70,6 +81,8 @@ struct rome_config {
 	u8 type;
 	char fwname[64];
 	uint8_t user_baud_rate;
+	u8 dnld_mode;
+	u8 dnld_type;
 };
 
 struct edl_event_hdr {
@@ -94,7 +107,8 @@ struct tlv_type_patch {
 	__le32 data_length;
 	__u8   format_version;
 	__u8   signature;
-	__le16 reserved1;
+	__u8   download_mode;
+	__u8   reserved1;
 	__le16 product_id;
 	__le16 rom_build;
 	__le16 patch_version;
@@ -119,6 +133,7 @@ struct tlv_type_hdr {
 
 int qca_set_bdaddr_rome(struct hci_dev *hdev, const bdaddr_t *bdaddr);
 int qca_uart_setup_rome(struct hci_dev *hdev, uint8_t baudrate);
+int qca_uart_setup_wcn3990(struct hci_dev *hdev, uint8_t baudrate);
 
 #else
 
@@ -132,4 +147,9 @@ static inline int qca_uart_setup_rome(struct hci_dev *hdev, int speed)
 	return -EOPNOTSUPP;
 }
 
+static inline int qca_uart_setup_wcn3990(struct hci_dev *hdev, int speed)
+{
+	return -EOPNOTSUPP;
+}
+
 #endif
