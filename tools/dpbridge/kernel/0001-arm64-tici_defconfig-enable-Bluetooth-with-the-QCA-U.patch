From f1c94c42423c6a59e8c28e2ea803d1754b463379 Mon Sep 17 00:00:00 2001
From: Memberoffoxhound <Memberoffoxhound@users.noreply.github.com>
Date: Wed, 18 Nov 2026 01:37:29 -0600
Subject: [PATCH 1/6] arm64: tici_defconfig: enable Bluetooth with the QCA UART
 driver

---
 arch/arm64/configs/tici_defconfig | 14 ++++++++------
 1 file changed, 8 insertions(+), 6 deletions(-)

diff --git a/arch/arm64/configs/tici_defconfig b/arch/arm64/configs/tici_defconfig
index f828be52..a4db7a87 100644
--- a/arch/arm64/configs/tici_defconfig
+++ b/arch/arm64/configs/tici_defconfig
@@ -1149,13 +1149,13 @@ CONFIG_CAN_MCP25XXFD=y
 # CONFIG_CAN_8DEV_USB is not set
 # CONFIG_CAN_DEBUG_DEVICES is not set
 # CONFIG_IRDA is not set
-CONFIG_BT=n
-CONFIG_BT_BREDR=n
-# CONFIG_BT_RFCOMM is not set
+CONFIG_BT=y
+CONFIG_BT_BREDR=y
+CONFIG_BT_RFCOMM=y
 # CONFIG_BT_BNEP is not set
 # CONFIG_BT_HIDP is not set
 CONFIG_BT_HS=n
-CONFIG_BT_LE=n
+CONFIG_BT_LE=y
 # CONFIG_BT_LEDS is not set
 # CONFIG_BT_SELFTEST is not set
 CONFIG_BT_DEBUGFS=n
@@ -1165,12 +1165,14 @@ CONFIG_BT_DEBUGFS=n
 #
 # CONFIG_BT_HCIBTUSB is not set
 # CONFIG_BT_HCIBTSDIO is not set
-# CONFIG_BT_HCIUART is not set
+CONFIG_BT_HCIUART=y
+CONFIG_BT_HCIUART_H4=y
+CONFIG_BT_HCIUART_QCA=y
 # CONFIG_BT_HCIBCM203X is not set
 # CONFIG_BT_HCIBFUSB is not set
 # CONFIG_BT_HCIVHCI is not set
 # CONFIG_BT_MRVL is not set
-CONFIG_MSM_BT_POWER=n
+CONFIG_MSM_BT_POWER=y
 CONFIG_BTFM_SLIM=n
 CONFIG_BTFM_SLIM_WCN3990=n
 # CONFIG_AF_RXRPC is not set
